# Copy to android/keystore.properties and fill in. That file is gitignored and must stay so:
# whoever holds this key can publish as you, and losing it ends the ability to update the
# listing at all. Prefer Play App Signing, which lets a lost *upload* key be reset.
#
#   keytool -genkeypair -v -keystore enchanted-chess.jks \
#     -keyalg RSA -keysize 2048 -validity 10000 -alias upload
storeFile=/absolute/path/to/enchanted-chess.jks
storePassword=
keyAlias=upload
keyPassword=
